rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function isNewDocOwner() {
      return isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string &&
             data.email is string;
    }

    function isValidUserSettings(data) {
      return (!('theme' in data) || data.theme in ['light', 'dark']) &&
             (!('unit' in data) || data.unit in ['mm', 'cm', 'm']) &&
             (!('gridEnabled' in data) || data.gridEnabled is bool) &&
             (!('floorEnabled' in data) || data.floorEnabled is bool) &&
             (!('allNotesVisible' in data) || data.allNotesVisible is bool);
    }

    function isCollaborator(modelId) {
      return isAuthenticated() && ('email' in request.auth.token) && (
        exists(/databases/$(database)/documents/collaborations/$(modelId + "_" + request.auth.token.email.lower())) ||
        exists(/databases/$(database)/documents/collaborations/$(modelId + "_" + request.auth.uid))
      );
    }

    function isInvited(modelId) {
      return isCollaborator(modelId);
    }

    function isModelOwner(modelId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/models/$(modelId)) &&
        get(/databases/$(database)/documents/models/$(modelId)).data.userId == request.auth.uid;
    }

    function isOwnCollaborationEmail(data) {
      return isAuthenticated() && ('email' in request.auth.token) &&
        data.email == request.auth.token.email.lower();
    }

    function isValidModel(data) {
      return data.keys().hasAll(['name', 'userId', 'shapes']) &&
             !('password' in data) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.shapes is list && data.shapes.size() <= 5000 &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 1000)) &&
             (!('scenes' in data) || (data.scenes is list && data.scenes.size() <= 500)) &&
             (!('customMaterials' in data) || (data.customMaterials is list && data.customMaterials.size() <= 1000)) &&
             (!('terrainModifiers' in data) || (data.terrainModifiers is list && data.terrainModifiers.size() <= 2000));
    }

    function isValidCollaboratorModelUpdate() {
      return request.resource.data.userId == resource.data.userId &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'shapes', 'tags', 'scenes', 'customMaterials', 'graphicsSettings',
               'animations', 'notes', 'customLights', 'timberFrameParams',
               'terrainModifiers', 'kernel', 'updatedAt', 'assetSchemaVersion',
               'assetCatalogRelease', 'environment', 'materialBindings'
             ]) &&
             isValidModel(request.resource.data);
    }

    function isValidMaterial(data) {
      return data.keys().hasAll(['userId', 'name', 'type']) &&
             data.userId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.type in ['color', 'texture', 'asset'] &&
             ((data.type in ['color', 'texture'] && data.value is string) ||
              (data.type == 'asset' && data.schemaVersion == 2 &&
               data.assetRef is map &&
               data.assetRef.assetId is string &&
               data.assetRef.assetId.matches('^ph:material:[a-z0-9][a-z0-9_-]*$') &&
               data.assetRef.revision is string && data.assetRef.revision.size() > 0 && data.assetRef.revision.size() < 200));
    }

    function isValidScript(data) {
      return data.keys().hasAll(['userId', 'name', 'code']) &&
             data.userId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.code is string && data.code.size() < 100000;
    }

    // The one account allowed to read the sign-in activity log (see loginActivity below).
    function isLoginActivityAdmin() {
      return isAuthenticated() && ('email' in request.auth.token) &&
        request.auth.token.email.lower() == 'craigtrickett@gmail.com';
    }

    function isValidLoginActivity(data) {
      return data.keys().hasOnly(['email', 'success', 'method', 'reason', 'userAgent', 'timestamp']) &&
             data.keys().hasAll(['email', 'success', 'method', 'timestamp']) &&
             data.email is string && data.email.size() <= 320 &&
             data.success is bool &&
             data.method in ['google', 'password'] &&
             (!('reason' in data) || data.reason == null || (data.reason is string && data.reason.size() <= 200)) &&
             (!('userAgent' in data) || data.userAgent == null || (data.userAgent is string && data.userAgent.size() <= 300)) &&
             data.timestamp == request.time;
    }

    function isValidWebsiteActivity(data) {
      return data.keys().hasOnly(['visitorId', 'sessionId', 'page', 'path', 'referrer', 'device', 'timestamp']) &&
             data.keys().hasAll(['visitorId', 'sessionId', 'page', 'path', 'device', 'timestamp']) &&
             data.visitorId is string && data.visitorId.size() > 0 && data.visitorId.size() <= 100 &&
             data.sessionId is string && data.sessionId.size() > 0 && data.sessionId.size() <= 100 &&
             data.page in ['home', 'features', 'claude', 'developers', 'sdk-docs'] &&
             data.path is string && data.path.size() > 0 && data.path.size() <= 120 &&
             (!('referrer' in data) || data.referrer == null || (data.referrer is string && data.referrer.size() <= 200)) &&
             data.device in ['desktop', 'tablet', 'mobile'] &&
             data.timestamp == request.time;
    }

    function isValidCollaboration(data) {
      return data.keys().hasAll(['modelId', 'email', 'role', 'status']) &&
             data.modelId is string && data.modelId.size() > 0 && data.modelId.size() <= 256 &&
             data.email is string && data.email.size() > 3 && data.email.size() <= 320 &&
             data.role in ['owner', 'collaborator'] &&
             data.status in ['invited', 'active', 'offline'] &&
             (!('uid' in data) || data.uid == null || (data.uid is string && data.uid.size() <= 128)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 200));
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['uid', 'displayName', 'text', 'timestamp']) &&
             data.uid is string &&
             data.displayName is string &&
             data.text is string && data.text.size() > 0 && data.text.size() < 1000 &&
             data.timestamp is number;
    }

    function isValidPasswordGate(data) {
      return data.keys().hasOnly(['algorithm', 'salt', 'hash', 'iterations', 'version']) &&
             data.keys().hasAll(['algorithm', 'salt', 'hash', 'iterations', 'version']) &&
             data.algorithm == 'PBKDF2-SHA256' &&
             data.salt is string && data.salt.size() >= 16 && data.salt.size() <= 128 &&
             data.hash is string && data.hash.size() >= 32 && data.hash.size() <= 256 &&
             data.iterations is int && data.iterations >= 100000 && data.iterations <= 1000000 &&
             data.version == 1;
    }

    function isValidRecipientCollaborationUpdate() {
      return request.resource.data.modelId == resource.data.modelId &&
             request.resource.data.email == resource.data.email &&
             request.resource.data.role == resource.data.role &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'displayName', 'status', 'lastSeen']) &&
             isValidCollaboration(request.resource.data);
    }

    // Rules Definitions

    // CMS: private draft, public published snapshot, immutable admin-only history.
    // Fields: content(map), revision(int), updatedBy(uid), updatedAt(timestamp).
    // Published/history also include draftRevision(int). Nested content is validated by the CMS.
    function isCmsAdmin() {
      return isLoginActivityAdmin() && request.auth.token.email_verified == true;
    }
    function validCmsContent(content) {
      return content is map && content.keys().hasOnly(['schemaVersion','copy','media','pages','links','replaceNavigation']) &&
        content.keys().hasAll(['schemaVersion','copy','media','pages','links','replaceNavigation']) &&
        content.schemaVersion == 1 && content.copy is map && content.copy.size() <= 2000 &&
        content.media is map && content.media.size() <= 300 && content.replaceNavigation is bool &&
        content.pages is list && content.pages.size() >= 5 && content.pages.size() <= 100 &&
        content.links is list && content.links.size() <= 100;
    }
    function validCmsRevision(data, published) {
      return data.keys().hasAll(['content','revision','updatedBy','updatedAt']) &&
        data.keys().hasOnly(published ? ['content','revision','updatedBy','updatedAt','draftRevision'] : ['content','revision','updatedBy','updatedAt']) &&
        validCmsContent(data.content) && data.revision is int && data.revision > 0 &&
        data.updatedBy == request.auth.uid && data.updatedAt == request.time &&
        (!published || (data.draftRevision is int && data.draftRevision > 0));
    }
    function matchesSavedDraft(data) {
      let draft = get(/databases/$(database)/documents/marketingCms/draft).data;
      let history = getAfter(/databases/$(database)/documents/marketingCmsHistory/$(string(data.revision))).data;
      return data.content == draft.content && data.draftRevision == draft.revision && history == data;
    }
    match /marketingCms/draft {
      allow get: if isCmsAdmin();
      allow create: if isCmsAdmin() && validCmsRevision(request.resource.data, false) && request.resource.data.revision == 1;
      allow update: if isCmsAdmin() && validCmsRevision(request.resource.data, false) && request.resource.data.revision == resource.data.revision + 1;
    }
    match /marketingCms/published {
      allow get: if true;
      allow create: if isCmsAdmin() && validCmsRevision(request.resource.data, true) && request.resource.data.revision == 1 && matchesSavedDraft(request.resource.data);
      allow update: if isCmsAdmin() && validCmsRevision(request.resource.data, true) && request.resource.data.revision == resource.data.revision + 1 && matchesSavedDraft(request.resource.data);
    }
    match /marketingCmsHistory/{version} {
      allow read: if isCmsAdmin();
      allow create: if isCmsAdmin() && validCmsRevision(request.resource.data, true) &&
        version == string(request.resource.data.revision) &&
        getAfter(/databases/$(database)/documents/marketingCms/published).data == request.resource.data;
    }

    match /user_settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /counters/{counterId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    match /models/{modelId} {
      allow list, get: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || resource.data.isPublic == true || isInvited(modelId));
      allow create: if isNewDocOwner() && isValidModel(request.resource.data);
      allow update: if (isDocOwner() && request.resource.data.userId == resource.data.userId && isValidModel(request.resource.data)) ||
                    (isInvited(modelId) && isValidCollaboratorModelUpdate());
      allow delete: if isDocOwner();

      // Password-protected sharing stores only a one-way PBKDF2 gate here,
      // never a plaintext password and never on the public model document.
      match /secure/{docId} {
        allow get: if docId == 'gate' && isAuthenticated() && (
          get(/databases/$(database)/documents/models/$(modelId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/models/$(modelId)).data.isPublic == true ||
          isInvited(modelId)
        );
        // Listing is owner-only for deletion cleanup.
        allow list: if isAuthenticated() &&
          get(/databases/$(database)/documents/models/$(modelId)).data.userId == request.auth.uid;
        allow create, update: if docId == 'gate' && isAuthenticated() &&
          get(/databases/$(database)/documents/models/$(modelId)).data.userId == request.auth.uid &&
          isValidPasswordGate(request.resource.data);
        allow delete: if isAuthenticated() &&
          get(/databases/$(database)/documents/models/$(modelId)).data.userId == request.auth.uid;
      }

      match /messages/{messageId} {
        allow read, list: if isAuthenticated() && (
          get(/databases/$(database)/documents/models/$(modelId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/models/$(modelId)).data.isPublic == true ||
          isInvited(modelId)
        );
        allow create: if isAuthenticated() && (isModelOwner(modelId) || isInvited(modelId)) && isValidChatMessage(request.resource.data);
        // Lets the model owner purge chat history when deleting the model
        // itself (see handleDelete in OpenModel.tsx) — otherwise these
        // would be orphaned, world-readable-to-collaborators documents
        // with no parent model left to scope access to.
        allow delete: if isAuthenticated() &&
          get(/databases/$(database)/documents/models/$(modelId)).data.userId == request.auth.uid;
      }
    }

    // Sign-in activity log (success and failure). Failed sign-ins happen before the user is
    // authenticated, so writes are open to anyone but tightly validated and append-only; only
    // the admin account can read it back, in the burger menu's Login Activity panel.
    match /loginActivity/{entryId} {
      allow create: if isValidLoginActivity(request.resource.data);
      allow get, list: if isLoginActivityAdmin();
      allow update, delete: if false;
    }

    // Anonymous marketing page-view analytics. Public clients can only append tightly validated
    // page views; the same admin-only account used for login activity can read the collection.
    match /websiteActivity/{entryId} {
      allow create: if isValidWebsiteActivity(request.resource.data);
      allow get, list: if isLoginActivityAdmin();
      allow update, delete: if false;
    }

    match /materials/{materialId} {
      allow get, list: if isDocOwner();
      allow create: if isNewDocOwner() && isValidMaterial(request.resource.data);
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || (('modelId' in resource.data) && isInvited(resource.data.modelId))) &&
        request.resource.data.userId == resource.data.userId &&
        (!('modelId' in resource.data) || request.resource.data.modelId == resource.data.modelId) &&
        isValidMaterial(request.resource.data);
      allow delete: if isDocOwner();
    }

    // Static manifests hold the full catalog. This small document is only
    // the public, revalidated active-release pointer; clients never write it.
    match /assetCatalogs/polyhaven {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    // Overflow storage for a single shape's geometryData when it's too
    // large to keep inline in its parent model document (see
    // src/lib/firestoreGeometryOffload.ts) - owner-scoped the same way as
    // materials/scripts above. Entries are content-addressed by a docId
    // that embeds the owning uid, so ownership can be checked without a
    // read-before-write.
    // Large meshes, images and terrain grids moved out of model documents.
    // Anyone who can open a model must be able to read its parts (invited
    // collaborators, public viewers), and a document's id - the saver's uid
    // plus a hash of its content - only appears inside the model it belongs
    // to. Only the saver can write or delete them.
    match /geometryOverflow/{docId} {
      allow get: if isAuthenticated();
      allow create: if isNewDocOwner();
      allow update: if isDocOwner() && isNewDocOwner();
      allow delete: if isDocOwner();
    }

    // Client presentation pages (/p/<shareId>). The id is 128 random bits and is the only way to
    // reach a page, so anyone holding the link may fetch that one document - but nobody can list
    // them except the owner, who finds their own to update or turn off.
    match /presentations/{shareId} {
      allow get: if true;
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && shareId.size() >= 20 && isValidPresentation(request.resource.data);
      allow update: if isDocOwner() && isValidPresentation(request.resource.data);
      allow delete: if isDocOwner();
    }

    // Comments on a client page. Anyone holding the link can read them and leave one under
    // a name (no account); only the page's owner can post as the designer, mark them read or
    // delete them.
    match /presentations/{shareId}/comments/{commentId} {
      allow get, list: if exists(/databases/$(database)/documents/presentations/$(shareId));
      allow create: if exists(/databases/$(database)/documents/presentations/$(shareId)) &&
        isValidComment(request.resource.data) &&
        (request.resource.data.fromDesigner == false && request.resource.data.read == false ||
         isPresentationOwner(shareId));
      allow update: if isPresentationOwner(shareId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        request.resource.data.read is bool;
      allow delete: if isPresentationOwner(shareId);
    }

    function isPresentationOwner(shareId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/presentations/$(shareId)).data.ownerId == request.auth.uid;
    }

    function isValidComment(data) {
      return data.keys().hasOnly(['authorName', 'text', 'createdAt', 'fromDesigner', 'read', 'anchor', 'replyTo']) &&
             data.keys().hasAll(['authorName', 'text', 'createdAt', 'fromDesigner', 'read']) &&
             data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 60 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 2000 &&
             data.createdAt == request.time &&
             data.fromDesigner is bool && data.read is bool &&
             (!('anchor' in data) || data.anchor == null || (data.anchor is list && data.anchor.size() == 3)) &&
             (!('replyTo' in data) || data.replyTo == null || (data.replyTo is string && data.replyTo.size() <= 40));
    }

    function isValidPresentation(data) {
      return data.ownerId == request.auth.uid &&
             data.keys().hasAll(['ownerId', 'title', 'storagePath', 'effects']) &&
             data.title is string && data.title.size() <= 120 &&
             data.storagePath is string &&
             data.storagePath.matches('presentations/' + request.auth.uid + '/[0-9A-Za-z]+/project[.]json') &&
             (!('message' in data) || (data.message is string && data.message.size() <= 4000));
    }

    match /scripts/{scriptId} {
      allow get, list: if isDocOwner() || resource.data.isPublic == true;
      allow create: if isNewDocOwner() && isValidScript(request.resource.data);
      allow update: if isDocOwner() && isValidScript(request.resource.data);
      allow delete: if isDocOwner();
    }

    match /collaborations/{collabId} {
      allow get, list: if isAuthenticated() && (
        isOwnCollaborationEmail(resource.data) || isModelOwner(resource.data.modelId) || isInvited(resource.data.modelId)
      );
      allow create: if isAuthenticated() && isValidCollaboration(request.resource.data) &&
        isModelOwner(request.resource.data.modelId);
      allow update: if isAuthenticated() && (
        (isOwnCollaborationEmail(resource.data) && isValidRecipientCollaborationUpdate()) ||
        (isModelOwner(resource.data.modelId) && isValidCollaboration(request.resource.data))
      );
      allow delete: if isAuthenticated() && (
        isOwnCollaborationEmail(resource.data) || isModelOwner(resource.data.modelId)
      );
    }

    // Scoped to the one fixed doc id firebase.ts's testConnection() actually
    // probes (doc(db, 'test', 'connection')) rather than the whole
    // collection — an intentionally open rule left as `match
    // /test/{testId}` is easy to widen further by accident later.
    match /test/connection {
      allow read: if true;
    }
  }
}
